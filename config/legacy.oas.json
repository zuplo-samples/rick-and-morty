{
    "openapi": "3.1.0",
    "info": {
      "version": "1.0.0",
      "title": "Dev Portal Proxy"
    },
    "paths": {
      "/docs{(.*)}": {
        "x-zuplo-path": {
          "pathMode": "url-pattern"
        },
        "get": {
          "summary": "Dev Portal",
          "description": "Proxy the Zudoku dev portal on the same domain",
          "x-zuplo-route": {
            "corsPolicy": "none",
            "handler": {
              "export": "legacyDevPortalHandler",
              "module": "$import(@zuplo/runtime)",
              "options": {
                "mode": "proxy"
              }
            },
            "policies": {
              "inbound": []
            }
          },
          "operationId": "dev-portal-proxy"
        }
      }
    }
  }